{
  "id": "opportunity_cost",
  "name": "Opportunity Cost",
  "description": "150 participants: does reminding about saving change purchase decisions? IMS Ch. 11.",
  "source": "openintro",
  "chapter": "IMS Ch. 11",
  "type": "randomization_prop",
  "variables": [
    {
      "name": "group",
      "label": "Treatment Group",
      "type": "categorical"
    },
