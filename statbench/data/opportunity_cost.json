      "name": "decision",
      "label": "Decision",
      "type": "categorical"
    }
  ],
  "studyDescription": "Researchers randomly assigned 150 students to one of two groups and asked them whether they would buy a DVD. The control group saw the options 'buy' or 'not buy.' The treatment group saw 'buy' or 'not buy — keep the $14.99 for other purchases.' The only difference was an explicit reminder that not buying meant keeping money for something else — an obvious fact, but one that might change behavior.",
  "variableDescriptions": {
    "group": "Whether the participant saw a simple choice (control) or was explicitly reminded that not buying means keeping money for other purchases (treatment).",
    "decision": "Whether the participant chose to buy the DVD or not buy it."
  },
  "sourceDetail": "OpenIntro IMS, Example 11.2. Based on Frederick et al. (2009), 'Opportunity Cost Neglect,' Journal of Consumer Research.",
  "context": {
    "population": "study participants",
    "parameter": "difference in purchase rate",
    "nullClaim": "reminding about savings has no effect on purchase decisions",
    "successLabel": "buy video"
  },
